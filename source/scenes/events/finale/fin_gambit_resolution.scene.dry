title: The Battle for Coruscant
subtitle: The Sith Lord's gambit is decided.
tags: event
view-if: finale and gambit and finale_day >= 3 and gambit_response_seen and not gambit_resolved
max-visits: 1
priority: 10
new-page: true
face-image: img/ev_war.svg
on-arrival: {!
Q.gambit_resolved = 1;
var reach = SW.palReach(Q);
// Order 66 needs the chips, and either a Chancellor long enough in office to plant the command codes
// or a plan so far advanced that his contingency is in place regardless
var o66 = Q.clones >= 3 && !Q.chips_removed && !Q.army_oversight;
var outside = Q.gambit_kind === 'coup' || Q.gambit_kind === 'resists';
if (outside && (Q.pal_office_months || 0) < 12 && Q.grand_plan < 55) o66 = false;
if (o66) { Q.order66 = 1; Q.jedi_strength = 1.5; }
var f = SW.forces(Q), P = f.sithParts;
var sith = f.sith, rep = f.rep;
// exposed before the Senate: his guards and governors defect, his allies desert, and the Senate rallies
if (Q.gambit_kind === 'exposed') sith -= P.security_bloc * 0.5 + P.guard * 0.5 + P.governors + 1;
// a coup from outside office (or a fight against our arrest): only as many follow him as his years in power bought
if (outside) sith -=(P.clones + P.navy + P.security_bloc + P.secret_army) * (1 - reach) + 1;
// the ratified Charter makes his move unconstitutional: his guards and governors stand aside
if (Q.charter_ratified && Q.gambit_kind !== 'exposed') sith -= (P.guard || 0) + (P.governors || 0);
// a Republic made whole: the worlds that came home stand with the Senate
if ((Q.road_rimward || 0) >= 3) rep += (Q.member_forces || 0) * 0.5 + 1;
// after a peace there is no war to justify him, the army is going home, and the returned worlds stand with the Senate
if (Q.peace_achieved) { sith -= 1.5 + P.clones * 0.4; if (!Q.pact_formed) rep += Q.member_forces * 0.5; }
if (sith < 0.5) sith = 0.5;
Q.gb_ratio = Math.round(100 * (rep + Q.gambit_bonus) / sith) / 100;
if (Q.gb_ratio > 1.1) { if (SW.sidiousEscapes(Q)) { Q.game_ending = 1; } else { Q.sidious_defeated = 1; Q.sidious_method = 'trial'; Q.sidious_gone = 1; } }
else if (Q.gb_ratio >= 0.6) { Q.civil_war_result = 'long'; Q.game_ending = 1; }
else { Q.empire_declared = 1; Q.game_ending = 1; }
!}

= The Battle for Coruscant

[? if order66 : In the first hours, the clones turn on the Jedi. The Order is almost destroyed. ?]

[? if sidious_defeated : The loyalists hold. [? if gambit_kind = "coup" and pact_formed : The coup's guards surrender when they see the Defence Pact squadrons overhead. ?][? if gambit_kind = "coup" and not pact_formed : The coup's guards surrender when the Judicial Forces' cruisers appear overhead. ?][? if gambit_kind = "resists" : The men who fought our arrest throw down their arms one company at a time, until only the red-robed guards outside his door are left. ?] Palpatine is found in a sealed chamber beneath the Senate, his face ruined by his own lightning, and taken alive. **Darth Sidious** will stand trial before the Senate he tried to destroy. ?][? if sidious_escaped : The loyalists hold Coruscant. But the sealed chamber beneath the Senate is empty, and a courier ship is missing from the Chancellery's private dock. Within the week **Darth Sidious** stands [? if not dooku_dead and not dooku_turned : beside Count Dooku?][? if dooku_dead or dooku_turned : at the head of the Confederacy?] on Raxus, and the droid armies, already winning their war, have a new master. ?][? if civil_war_result = "long" : Coruscant is split block by block, and then the galaxy splits with it. The Sith Lord holds the capital and the Core, and the Free Republic the rest. ?][? if empire_declared : The loyalists are overwhelmed. By dawn, Palpatine stands before a cowed Senate and proclaims the Galactic Empire. ?]
