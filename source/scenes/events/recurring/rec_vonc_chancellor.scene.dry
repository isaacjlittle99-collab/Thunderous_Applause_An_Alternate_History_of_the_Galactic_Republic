title: No Confidence in the Chancellor
new-page: true
face-image: img/ev_senate.svg
on-arrival: {!
var st = SW.stance(Q, {mod: 0.35, guild: 0.3, rim: 0.5, sec: 0.15, ind: 0.4, pal: 0, cis: 0.6}, true);
var adj = (Q.evidence - 5) * 0.04 + (Q.senate_resolve - 4) * 0.03 + (Q.corruption - 60) / 300;
for (var b in st) if (b !== 'pal') st[b] = SW.clamp(st[b] + adj, 0, 1);
if (Q.chancellor_bloc !== 'pal') { st.pal = 0.6; st[Q.chancellor_bloc] = 0.05; }
Q.vc_vote = SW.vote(Q, st, 1, 'vonc');
Q.vote_html = SW.voteBanner('No confidence in Chancellor ' + Q.chancellor, Q.vc_vote);
if (Q.vc_vote >= 50) { Q.election_due = 1; Q.govt_fell_now = 1; Q.fall_reason = 'vonc'; Q.vc_passed = 1; Q.senate_resolve += 1; if (Q.pal_chancellor) { Q.pal_relation -= 25; Q.evidence_public += 0.5; } }
else { Q.vc_passed = 0; Q.senate_resolve -= 1.5; Q.pal_relation -= 15; Q.grand_plan += 4; Q.faith -= 1; for (var i = 0; i < SW.REGIONS.length; i++) Q[SW.REGIONS[i] + '_rc'] *= 0.95; }
!}

= No Confidence in the Chancellor

[+ vote_html +]

[? if vc_passed : The Senate has withdrawn its confidence in Chancellor [+ chancellor +]. A new election will follow. It is the first time in a generation that the Senate has dared to do such a thing to a popular Chancellor. ?][? if not vc_passed : The motion fails. The Chancellor graciously "forgives" the Caucus for its "understandable anxieties". His allies are less forgiving, and our support drains away. ?]
