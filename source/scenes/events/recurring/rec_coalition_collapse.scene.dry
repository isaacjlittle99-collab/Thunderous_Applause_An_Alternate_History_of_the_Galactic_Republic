title: The Government Falls
subtitle: Our coalition partners have walked out.
tags: event
view-if: rc_in_govt and coalition_dissent >= 4 and not finale and not election_due and not game_ending
priority: 6
new-page: true
face-image: img/ev_senate.svg
on-arrival: {!
Q.cc_kept = 0; Q.cc_dropped = 0;
Q.rc_momentum -= 0.5; Q.faith -= 1; Q.govt_fell = (Q.govt_fell || 0) + 1;
if (!Q.constructive_vonc) {
    SW.walkout(Q, 24);
    Q.election_due = 1; Q.govt_fell_now = 1; Q.fall_reason = 'collapse';
} else if (Q.rc_chancellor) {
    // the Chancellor survives; the partner simply leaves
    var gone = SW.walkout(Q, 24);
    var rest = (Q.govt_blocs || []).filter(function (b) { return b !== gone; });
    if (rest.length > 1) SW.setGovt(Q, rest);
    else SW.setGovt(Q, gone === 'ind' ? ['rc'] : ['rc', 'ind'], 'Caucus Minority Government');
    Q.coalition_dissent = 1; Q.cc_kept = 1;
    SW.assignChairs(Q);
} else {
    // the Chancellor keeps his government and drops the Caucus instead
    var others = (Q.govt_blocs || []).filter(function (b) { return b !== 'rc'; });
    SW.setGovt(Q, others, Q.coalition_name);
    SW.walkout(Q, 12, Q.chancellor_bloc);
    SW.assignChairs(Q);
    Q.cc_dropped = 1;
}
!}

= The Government Falls

[? if not cc_dropped : The [+ walkout_name +] have had enough, and walk out of the coalition. ?][? if cc_dropped : Our partners have had enough of the Caucus. ?]

[? if govt_fell_now and rc_chancellor : They join a motion of no confidence in Chancellor [+ chancellor +], and it passes. The Senate must elect a new Supreme Chancellor. ?][? if govt_fell_now and not rc_chancellor : Without them the government has no majority, and it collapses. The Senate must elect a new Supreme Chancellor. ?][? if cc_kept : Under the constructive no-confidence rule they cannot bring Chancellor [+ chancellor +] down without agreeing on a successor, so the government carries on without them, weaker than before: the [+ coalition_name +]. ?][? if cc_dropped : Under the constructive no-confidence rule the Chancellor cannot be brought down, so the coalition simply drops the Caucus and governs without us. Our committee chairs go with it. ?]

[? if not cc_dropped : The [+ walkout_name +] will not serve in a government with the Caucus for the next two years. ?][? if cc_dropped : The [+ walkout_name +] will not have us back for at least a year. ?]

*The coalition's mood worsens every turn we govern, and faster with hardline partners. Concessions in a strain, the Coalition Affairs card and some advisors can calm it.*
