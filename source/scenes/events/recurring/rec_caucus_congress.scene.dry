[+ rcg_analysis +]

[+ rcg_box +]

[? if not rcg_deadlock : [+ rcg_result +] ?]

[? if not rcg_deadlock : [+ rcg_effect +] ?]

- @rcg_round2: Continue...

@rcg_round2
view-if: rcg_deadlock
new-page: true

