new-page: true
face-image: img/ev_naboo.svg
on-arrival: {!
Q.fear += 6;
Q.naboo_sympathy = 1;
for (var i = 0; i < SW.REGIONS.length; i++) Q[SW.REGIONS[i] + '_pal'] += 1.5;
